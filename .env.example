# Groundwork — one configuration for the one backend. Copy to .env (never commit .env).
# Every integration defaults to a real local implementation; nothing pretends to be a cloud service.

ENVIRONMENT=development              # development | test | production
# PostgreSQL on Cloud SQL in production (Cloud Run mounts the socket under /cloudsql):
#   postgresql+psycopg://groundwork:${DB_PASSWORD}@/groundwork?host=/cloudsql/PROJECT:REGION:INSTANCE
# Local default (if unset): SQLite at backend/var/groundwork.db
# DATABASE_URL=postgresql+psycopg://postgres:@127.0.0.1:5432/groundwork

JWT_SECRET=change-me-to-a-random-64-character-string   # from Secret Manager in production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://localhost:5173

# Google Cloud — authenticated with Application Default Credentials / Workload Identity. No key files.
GCP_PROJECT=
GCP_LOCATION=us-central1

STORAGE_BACKEND=local                # local | gcs
GCS_BUCKET=

EXTRACTION_BACKEND=local             # local (text layer only, no OCR) | documentai
DOCUMENTAI_LOCATION=us
DOCUMENTAI_PROCESSOR_ID=

AI_BACKEND=none                      # none | vertex (Gemini on Vertex AI, ADC) | gemini_api (AI Studio key)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=                      # only for AI_BACKEND=gemini_api; never commit a real key
STUDIO_RATE_PER_MINUTE=60            # Engineering Studio calls per user per minute

PII_BACKEND=local                    # local | dlp  (Sensitive Data Protection)

WORKFLOW_EXECUTION_ENABLED=true      # the kill switch for every approved action
REQUIRE_SEPARATE_APPROVER=true
NOTIFY_WEBHOOK_URL=                  # optional Slack-compatible webhook
MAX_UPLOAD_MB=25
WEBHOOK_SIGNING_SECRET=              # HMAC key for outbound webhooks + scheduler calls (Secret Manager in production)

# Bounded resources (defaults shown)
# DB_POOL_SIZE=5  DB_MAX_OVERFLOW=5  DB_POOL_TIMEOUT_SECONDS=10  DB_CONNECT_TIMEOUT_SECONDS=10  DB_STATEMENT_TIMEOUT_MS=30000
# PROVIDER_TIMEOUT_SECONDS=60  PROVIDER_ATTEMPTS=3  DOCUMENTAI_MAX_MB=20  DOCUMENTAI_MAX_PAGES=15
# GEMINI_MAX_OUTPUT_TOKENS=2048  GEMINI_MAX_PROMPT_CHARS=60000  ASSISTANT_RATE_PER_MINUTE=20
# LOG_JSON=          # default: JSON (Cloud Logging format) in production, text locally
# LOG_LEVEL=INFO

# ── Canton Network: multi-party external approvals (docs/canton) ────────────
# Off by default; Groundwork works fully without it. Never commit real values.
GROUNDWORK_CANTON_ENABLED=false
GROUNDWORK_CANTON_NETWORK=localnet          # localnet | devnet | testnet | mainnet (localnet is refused in production)
CANTON_API_MODE=json                        # JSON Ledger API v2
CANTON_PACKAGE_NAME=groundwork-approvals
CANTON_APPROVAL_PACKAGE_ID=
CANTON_SYNCHRONIZER_ID=
CANTON_COMMAND_TIMEOUT_SECONDS=30
CANTON_EVENT_POLL_INTERVAL_SECONDS=5
CANTON_BACKGROUND_SYNC=true                 # false on Cloud Run: use the canton-sync scheduled job
CANTON_CA_BUNDLE=
CANTON_LEGAL_AID_LEDGER_URL=
CANTON_LEGAL_AID_PARTY_ID=
CANTON_LEGAL_AID_USER_ID=groundwork-legalaid
CANTON_LEGAL_AID_SECRET_REF=                # LocalNet HMAC only
CANTON_LEGAL_AID_OIDC_TOKEN_URL=            # DevNet/TestNet/MainNet
CANTON_LEGAL_AID_OIDC_CLIENT_ID=
CANTON_LEGAL_AID_OIDC_CLIENT_SECRET=        # from Secret Manager
CANTON_LEGAL_AID_OIDC_AUDIENCE=
CANTON_REGISTRY_LEDGER_URL=
CANTON_REGISTRY_PARTY_ID=
CANTON_REGISTRY_USER_ID=groundwork-registry
CANTON_REGISTRY_SECRET_REF=
CANTON_REGISTRY_OIDC_TOKEN_URL=
CANTON_REGISTRY_OIDC_CLIENT_ID=
CANTON_REGISTRY_OIDC_CLIENT_SECRET=
CANTON_REGISTRY_OIDC_AUDIENCE=
