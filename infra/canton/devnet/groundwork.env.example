# Groundwork on Canton DEVNET. Fill from YOUR devnet onboarding (validator operator / NaaS provider).
# Nothing here is shared with any other network: separate parties, IdP clients, secrets and egress IPs.
GROUNDWORK_CANTON_ENABLED=true
GROUNDWORK_CANTON_NETWORK=devnet
CANTON_API_MODE=json
CANTON_SYNCHRONIZER_ID=<global synchronizer id reported by your devnet participant: GET /v2/state/connected-synchronizers>
CANTON_APPROVAL_PACKAGE_ID=<package id printed by: dpm build / daml damlc inspect-dar>
CANTON_BACKGROUND_SYNC=false
CANTON_LEGAL_AID_LEDGER_URL=https://<legal-aid devnet participant JSON API host>
CANTON_LEGAL_AID_PARTY_ID=<LegalAid party id allocated on your devnet validator>
CANTON_LEGAL_AID_USER_ID=<ledger API user with actAs/readAs for that party>
CANTON_LEGAL_AID_OIDC_TOKEN_URL=https://<your IdP>/oauth/token
CANTON_LEGAL_AID_OIDC_CLIENT_ID=<client id>
CANTON_LEGAL_AID_OIDC_AUDIENCE=<ledger API audience configured on the participant>
# CANTON_LEGAL_AID_OIDC_CLIENT_SECRET comes from Secret Manager: groundwork-canton-devnet-legal-aid-client-secret
# Registry: in an institutional deployment the registry runs its OWN participant and front end; set these
# only for a demonstration where both credentials are held by this deployment (see docs/canton/security.md).
CANTON_REGISTRY_LEDGER_URL=https://<registry devnet participant JSON API host>
CANTON_REGISTRY_PARTY_ID=<Registry party id>
CANTON_REGISTRY_USER_ID=<registry ledger API user>
CANTON_REGISTRY_OIDC_TOKEN_URL=https://<registry IdP>/oauth/token
CANTON_REGISTRY_OIDC_CLIENT_ID=<client id>
CANTON_REGISTRY_OIDC_AUDIENCE=<audience>
# CANTON_REGISTRY_OIDC_CLIENT_SECRET from Secret Manager: groundwork-canton-devnet-registry-client-secret
